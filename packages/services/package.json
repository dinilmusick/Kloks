{
  "name": "@kloks/services",
  "version": "1.0.0",
  "description": "Kloks Canonical Services A-D (Pure, Stateful, Event-Emitting, Protocol-Enabled) built on KrnlTS",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean --external @dinilmusick/krnl",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@dinilmusick/krnl": "file:../../../KrnlTS"
  }
}
