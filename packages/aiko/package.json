{
  "name":"@kloks/aiko",
  "version":"1.0.0",
  "description":"Embedded Aiko application module runtime for Skipo applications.",
  "type":"module",
  "private":false,
  "publishConfig":{"access":"public","registry":"https://registry.npmjs.org/"},
  "main":"./dist/index.js",
  "types":"./dist/index.d.ts",
  "module":"./dist/index.js",
  "exports":{".":{"import":"./dist/index.js","types":"./dist/index.d.ts","default":"./dist/index.js"}},
  "scripts":{"build":"tsup src/index.ts --format esm --dts --clean --external @ultrst-armada/krnl","typecheck":"tsc --noEmit","test":"vitest run","clean":"rm -rf dist"},
  "dependencies":{"@ultrst-armada/krnl":"workspace:*"},
  "devDependencies":{"@ultrst-armada/krnl":"^1.0.8","tsup":"^8.4.0","typescript":"^5.7.3","vitest":"^3.1.0"}
}
