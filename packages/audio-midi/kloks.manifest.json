{
  "$schema": "https://skipo.dev/schemas/kloks-manifest.v1.json",
  "package": "@kloks/audio-midi",
  "version": "1.0.0",
  "services": [
    {
      "id": "audio",
      "name": "Audio Hardware Service",
      "version": "1.0.0",
      "description": "Audio worklet stream capture, device query, and buffer processor.",
      "backend": {
        "package": "@kloks/audio-midi",
        "export": "AudioHardwareServiceFacade",
        "facade": "AudioHardwareServiceFacade"
      },
      "modes": [
        "backend",
        "fullstack"
      ],
      "targets": {
        "backend": [
          "BackendFacade.services"
        ],
        "frontend": [
          "App.main-content"
        ]
      },
      "dependencies": [],
      "defaultFrontend": {
        "component": "BaseCard",
        "package": "@ultrst-armada/floks/ui",
        "export": "BaseCard",
        "relationship": "recommended"
      }
    },
    {
      "id": "midi",
      "name": "MIDI Hardware Service",
      "version": "1.0.0",
      "description": "Legacy compatibility facade for the historical MIDI subsystem. New applications should use the independent MIDI protocol/device service; clock timing is provided separately by the Clock Service.",
      "backend": {
        "package": "@kloks/audio-midi",
        "export": "MidiServiceFacade",
        "facade": "MidiServiceFacade"
      },
      "modes": [
        "backend"
      ],
      "targets": {
        "backend": [
          "BackendFacade.services"
        ]
      },
      "dependencies": []
    },
    {
      "id": "clock",
      "name": "Application Clock Service",
      "version": "1.0.0",
      "description": "Generic monotonic application timing, musical position, tempo, subdivisions and deterministic lifecycle; independent from MIDI and OSC.",
      "backend": {
        "package": "@ultrst-armada/kloks",
        "export": "ClockServiceFacade",
        "facade": "ClockServiceFacade",
        "subpath": "services"
      },
      "modes": [
        "backend",
        "fullstack"
      ],
      "targets": {
        "backend": [
          "BackendFacade.services"
        ],
        "frontend": [
          "App.main-content"
        ]
      },
      "dependencies": [],
      "capabilities": [
        "application-timing",
        "monotonic-clock",
        "musical-position",
        "tempo",
        "subdivisions"
      ]
    },
    {
      "id": "midi-protocol",
      "name": "MIDI Protocol and Device Service",
      "version": "1.0.0",
      "description": "Capability-gated physical MIDI discovery, independent input/output lifecycle, MIDI message encoding/decoding and logical in-process endpoints.",
      "backend": {
        "package": "@ultrst-armada/kloks",
        "export": "CanonicalMidiServiceFacade",
        "facade": "CanonicalMidiServiceFacade",
        "subpath": "services"
      },
      "modes": [
        "backend",
        "fullstack"
      ],
      "targets": {
        "backend": [
          "BackendFacade.services"
        ],
        "frontend": [
          "App.main-content"
        ]
      },
      "dependencies": [],
      "capabilities": [
        "midi-input",
        "midi-output",
        "device-discovery",
        "logical-midi-endpoints",
        "hot-plug"
      ]
    },
    {
      "id": "osc",
      "name": "OSC Protocol and Endpoint Service",
      "version": "1.0.0",
      "description": "Independent OSC client/server, binary message and bundle codec, address patterns, endpoint lifecycle and injected runtime-specific transports.",
      "backend": {
        "package": "@ultrst-armada/kloks",
        "export": "OscServiceFacade",
        "facade": "OscServiceFacade",
        "subpath": "services"
      },
      "modes": [
        "backend",
        "fullstack"
      ],
      "targets": {
        "backend": [
          "BackendFacade.services"
        ],
        "frontend": [
          "App.main-content"
        ]
      },
      "dependencies": [],
      "capabilities": [
        "osc-client",
        "osc-server",
        "osc-bundles",
        "address-patterns",
        "runtime-transport-injection"
      ]
    }
  ],
  "orchestrations": [
    {
      "id": "audio-midi",
      "name": "Audio & MIDI Orchestrator",
      "version": "1.0.0",
      "package": "@kloks/audio-midi",
      "export": "AudioMidiOrchestratorDefinition",
      "targetTypes": [
        "BackendFacade.orchestrations"
      ]
    }
  ]
}
