{
  "name": "@ultrst-armada/kloks-fod",
  "version": "1.0.0",
  "description": "Embedded FOD workflow orchestration module for Skipo applications.",
  "type": "module",
  "private": false,
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./quickjs-node": {
      "types": "./dist/quickjs-node.d.ts",
      "import": "./dist/quickjs-node.js",
      "default": "./dist/quickjs-node.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/quickjs-node.ts src/quickjs-worker.ts --format esm --dts --clean --external @ultrst-armada/krnl",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@jitl/quickjs-wasmfile-release-sync": "0.32.0",
    "@ultrst-armada/kloks": "workspace:*",
    "quickjs-emscripten-core": "0.32.0"
  },
  "devDependencies": {
    "@ultrst-armada/krnl": "^1.0.9",
    "tsup": "^8.4.0",
    "typescript": "^5.7.3",
    "vitest": "^3.1.0",
    "@types/node": "^22.15.0"
  }
}
