{
  "name": "@kloks/state-graph",
  "version": "1.0.0",
  "description": "Kloks Non-UI State, Execution & Node-Graph Domain/Rules/Spatial Services built on KrnlTS",
  "type": "module",
  "private": false,
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "skipoManifest": "./kloks.manifest.json",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./state": {
      "import": "./dist/state/index.js",
      "types": "./dist/state/index.d.ts",
      "default": "./dist/state/index.js"
    },
    "./execution": {
      "import": "./dist/execution/index.js",
      "types": "./dist/execution/index.d.ts",
      "default": "./dist/execution/index.js"
    },
    "./domain": {
      "import": "./dist/domain/index.js",
      "types": "./dist/domain/index.d.ts",
      "default": "./dist/domain/index.js"
    },
    "./rules": {
      "import": "./dist/rules/index.js",
      "types": "./dist/rules/index.d.ts",
      "default": "./dist/rules/index.js"
    },
    "./spatial": {
      "import": "./dist/spatial/index.js",
      "types": "./dist/spatial/index.d.ts",
      "default": "./dist/spatial/index.js"
    },
    "./store": {
      "import": "./dist/store/index.js",
      "types": "./dist/store/index.d.ts",
      "default": "./dist/store/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/state/index.ts src/execution/index.ts src/domain/index.ts src/rules/index.ts src/spatial/index.ts src/store/index.ts --format esm --dts --clean --external zustand --external bullmq --external react --external ws",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@kloks/functions": "workspace:*",
    "bullmq": "^6.3.8",
    "zustand": "^5.0.15"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@ultrst-armada/krnl": "^1.0.0"
  }
}
