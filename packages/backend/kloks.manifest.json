{
  "$schema": "https://skipo.dev/schemas/kloks-manifest.v1.json",
  "package": "@kloks/backend",
  "version": "1.1.0",
  "services": [
    {
      "id": "auth",
      "name": "Authentication & Session Management",
      "version": "1.0.0",
      "description": "Enterprise multi-session token lifecycle, password hashing, and rate limiting service.",
      "backend": {
        "package": "@kloks/backend",
        "subpath": "krnl-services",
        "export": "AuthServiceFacade",
        "facade": "AuthServiceFacade"
      },
      "modes": [
        "backend",
        "fullstack"
      ],
      "targets": {
        "backend": [
          "BackendFacade.services"
        ],
        "frontend": [
          "App.main-content"
        ]
      },
      "dependencies": [],
      "defaultFrontend": {
        "component": "AuthPage",
        "package": "@ultrst-armada/floks/ui",
        "relationship": "recommended"
      }
    },
    {
      "id": "storage",
      "name": "Cloud & Workspace Storage",
      "version": "1.0.0",
      "description": "Unified S3, Supabase, B2, and local filesystem presigned transfer service.",
      "backend": {
        "package": "@kloks/backend",
        "subpath": "krnl-services",
        "export": "StorageServiceFacade",
        "facade": "StorageServiceFacade"
      },
      "modes": [
        "backend",
        "fullstack"
      ],
      "targets": {
        "backend": [
          "BackendFacade.services"
        ],
        "frontend": [
          "App.main-content"
        ]
      },
      "dependencies": [
        "srkl"
      ],
      "defaultFrontend": {
        "component": "WorkspaceTilesMenu",
        "package": "@ultrst-armada/floks/ui",
        "relationship": "recommended"
      }
    },
    {
      "id": "workspace",
      "name": "Workspace Management",
      "version": "1.0.0",
      "description": "Multi-tenant workspace isolation and canonical sync replication service.",
      "backend": {
        "package": "@kloks/backend",
        "subpath": "krnl-services",
        "export": "WorkspaceServiceFacade",
        "facade": "WorkspaceServiceFacade"
      },
      "modes": [
        "backend",
        "fullstack"
      ],
      "targets": {
        "backend": [
          "BackendFacade.services"
        ],
        "frontend": [
          "App.main-content"
        ]
      },
      "dependencies": [
        "auth",
        "storage",
        "srkl"
      ],
      "defaultFrontend": {
        "component": "WorkspaceTilesMenu",
        "package": "@ultrst-armada/floks/ui",
        "relationship": "recommended"
      }
    },
    {
      "id": "control-plane",
      "name": "Control Plane Service",
      "version": "1.0.0",
      "description": "Control plane health checking, telemetry, and system lifecycle monitoring.",
      "backend": {
        "package": "@kloks/backend",
        "subpath": "krnl-services",
        "export": "ControlPlaneServiceFacade",
        "facade": "ControlPlaneServiceFacade"
      },
      "modes": [
        "backend",
        "fullstack"
      ],
      "targets": {
        "backend": [
          "BackendFacade.services"
        ],
        "frontend": [
          "App.footer"
        ]
      },
      "dependencies": [],
      "defaultFrontend": {
        "component": "StatusIndicator",
        "package": "@ultrst-armada/floks/ui",
        "relationship": "recommended"
      }
    },
    {
      "id": "database",
      "name": "Database Service",
      "version": "1.0.0",
      "description": "SQL and transaction execution driver service.",
      "backend": {
        "package": "@kloks/backend",
        "subpath": "krnl-services",
        "export": "DatabaseServiceFacade",
        "facade": "DatabaseServiceFacade"
      },
      "modes": [
        "backend"
      ],
      "targets": {
        "backend": [
          "BackendFacade.services"
        ]
      },
      "dependencies": []
    },
    {
      "id": "gemini",
      "name": "Google Gemini AI Service",
      "version": "1.0.0",
      "description": "Gemini text and multimodal generation service.",
      "backend": {
        "package": "@kloks/backend",
        "subpath": "krnl-services",
        "export": "GeminiServiceFacade",
        "facade": "GeminiServiceFacade"
      },
      "modes": [
        "backend"
      ],
      "targets": {
        "backend": [
          "BackendFacade.services"
        ]
      },
      "dependencies": []
    },
    {
      "id": "srkl",
      "name": "SRKL Credential Federation",
      "version": "1.0.0",
      "description": "Service-account discovery and Backblaze B2 bucket federation for reusable application modules.",
      "backend": {
        "package": "@kloks/backend",
        "subpath": "krnl-services",
        "export": "SrklServiceFacade",
        "facade": "SrklServiceFacade"
      },
      "modes": [
        "backend",
        "fullstack"
      ],
      "targets": {
        "backend": [
          "BackendFacade.services"
        ]
      },
      "dependencies": []
    },
    {
      "id": "github-actions",
      "name": "GitHub Actions Execution",
      "version": "1.0.0",
      "description": "Authenticated GitHub Actions workflow dispatch, observation, logs, artifacts, cancellation and rerun service.",
      "backend": {
        "package": "@ultrst-armada/kloks",
        "subpath": "development",
        "export": "GitHubActionsServiceFacade",
        "facade": "GitHubActionsServiceFacade"
      },
      "modes": [
        "backend",
        "fullstack"
      ],
      "targets": {
        "backend": [
          "BackendFacade.services"
        ]
      },
      "dependencies": []
    },
    {
      "id": "web-container",
      "name": "WebContainer Runtime",
      "version": "1.1.0",
      "description": "Canonical browser WebContainer lifecycle, filesystem mounting and arbitrary development command execution.",
      "backend": {
        "package": "@ultrst-armada/kloks",
        "subpath": "development",
        "export": "WebContainerServiceFacade",
        "facade": "WebContainerServiceFacade"
      },
      "modes": [
        "fullstack"
      ],
      "targets": {
        "backend": [
          "App.main-content"
        ]
      },
      "dependencies": []
    },
    {
      "id": "development",
      "name": "Development & Validation",
      "version": "1.0.0",
      "description": "Provider-neutral development execution planning and validation across WebContainer and GitHub Actions.",
      "backend": {
        "package": "@ultrst-armada/kloks",
        "subpath": "development",
        "export": "DevelopmentServiceFacade",
        "facade": "DevelopmentServiceFacade"
      },
      "modes": [
        "backend",
        "fullstack"
      ],
      "targets": {
        "backend": [
          "BackendFacade.services"
        ]
      },
      "dependencies": [
        "github-actions",
        "web-container",
        "code-validation"
      ]
    },
    {
      "id": "code-validation",
      "name": "Code Validation & Diagnostics",
      "version": "1.0.0",
      "description": "Shared syntax, lint, test, build, KrnlTS, FrnlTS and Law L9 validation pipeline backed by the canonical WebContainer runtime.",
      "backend": {
        "package": "@ultrst-armada/kloks",
        "subpath": "development",
        "export": "CodeValidationServiceFacade",
        "facade": "CodeValidationServiceFacade"
      },
      "modes": [
        "fullstack"
      ],
      "targets": {
        "backend": [
          "App.main-content"
        ],
        "frontend": [
          "App.main-content"
        ]
      },
      "dependencies": [
        "web-container"
      ]
    },
    {
      "id": "code-diagnostics",
      "name": "TypeScript Code Diagnostics",
      "version": "1.0.0",
      "description": "Editor-facing TypeScript diagnostics runner for authored source.",
      "backend": {
        "package": "@ultrst-armada/kloks",
        "subpath": "development",
        "export": "codeDiagnosticsService",
        "facade": "codeDiagnosticsService"
      },
      "modes": [
        "fullstack"
      ],
      "targets": {
        "backend": [
          "App.main-content"
        ],
        "frontend": [
          "App.main-content"
        ]
      },
      "dependencies": [
        "web-container"
      ]
    }
  ]
}
