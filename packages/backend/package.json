  "skipoManifest": "./kloks.manifest.json",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./ui-session": {
      "types": "./dist/api/uiSession.d.ts",
      "import": "./dist/api/uiSession.js",
      "default": "./dist/api/uiSession.js"
