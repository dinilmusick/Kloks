  "scripts": {
    "build": "tsup src/index.ts src/node.ts src/storage/node.ts src/services/node.ts src/workspace/node.ts src/krnl-services.ts src/krnl-ai-services.ts src/resolver/index.ts src/services/index.ts src/auth/index.ts src/storage/index.ts src/storage-workspace.ts src/workspace/index.ts src/control-plane/index.ts src/api/index.ts src/api/uiSession.ts src/connectivity/index.ts src/client/index.ts src/srkl/index.ts src/development/index.ts src/development/webContainerService.ts src/development/webContainerRuntime.ts src/development/playwrightInspectionService.ts src/development/playwrightInspectionTypes.ts src/ai-provider/index.ts src/ai-inference/index.ts src/ai-models/index.ts src/ai-routing/index.ts src/ai-keys/index.ts src/ai-tools/index.ts src/provider-services/index.ts src/provider-services/node.ts src/provider-services/storage.ts src/provider-services/storage/node.ts src/provider-services/storage/github.ts src/provider-services/storage/backblaze-b2.ts src/provider-services/storage/dropbox.ts src/provider-services/google/index.ts src/provider-services/google/drive.ts src/provider-services/google/gemini.ts src/provider-services/google/cloud-run.ts src/provider-services/google/cloud-storage.ts src/provider-services/google/cloud-shell.ts src/provider-services/google/vertex-ai.ts --format esm --clean --external @kloks/wasm-runtime --external react --external @kloks/state-graph --external @neondatabase/serverless --external @supabase/supabase-js --external @aws-sdk/client-s3 --external @aws-sdk/lib-storage --external zod --external ws --external @webcontainer/api --external playwright --external @dinilmusick/gutts && tsc --emitDeclarationOnly --declaration --project tsconfig.json && tsup src/development/client.ts --format esm --dts --out-dir dist/development --splitting false --platform browser --external @ultrst-armada/krnl",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@dinilmusick/gutts": "2.2.2",
    "@kloks/functions": "workspace:*",
    "@kloks/state-graph": "workspace:*",
    "@webcontainer/api": "^1.6.4",
    "@kloks/wasm-runtime": "workspace:*"
  },
  "peerDependencies": {
    "@neondatabase/serverless": "^0.10.0",
    "@supabase/supabase-js": "^2.45.0",
    "react": "^18.0.0 || ^19.0.0",
    "zod": "^3.22.0",
    "@ultrst-armada/krnl": "^1.0.9",
    "@aws-sdk/client-s3": "^3.1164.0"
  },
  "peerDependenciesMeta": {
    "@supabase/supabase-js": {
      "optional": true
    },
    "@neondatabase/serverless": {
      "optional": true
    },
    "zod": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "@ultrst-armada/krnl": {
      "optional": true
    },
    "@aws-sdk/client-s3": {
      "optional": true
    }
  },
  "devDependencies": {
    "@ultrst-armada/krnl": "^1.0.9"
  }
}
